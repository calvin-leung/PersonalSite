---
interface Props {
  position: string;
  name: string;
  url?: string;
  startDate: string;
  endDate?: string;
  summary?: string;
  highlights?: string[];
}

const { position, name, url, startDate, endDate, summary, highlights } = Astro.props;

function fmt(d: string) {
  if (!d) return 'Present';
  const [year, month] = d.split('-');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${months[parseInt(month) - 1]} ${year}`;
}
---

<div class="entry group">
  <div class="flex justify-between items-start gap-4 mb-1.5">
    <div>
      <div class="font-medium text-[0.95rem] text-ink">{position}</div>
      <div class="text-muted text-sm mt-0.5">
        {url
          ? <a href={url} target="_blank" class="hover:text-accent transition-colors">{name}</a>
          : name}
      </div>
    </div>
    <div class="text-xs text-muted whitespace-nowrap font-mono pt-0.5 shrink-0">
      {fmt(startDate)} – {fmt(endDate || '')}
    </div>
  </div>
  {summary && <p class="text-sm text-ink/70 mb-2 leading-relaxed">{summary}</p>}
  {highlights?.length && (
    <ul class="space-y-1">
      {highlights.map(h => (
        <li class="text-sm text-ink/70 pl-4 relative leading-snug before:content-['–'] before:absolute before:left-0 before:text-accent">
          {h}
        </li>
      ))}
    </ul>
  )}
</div>
