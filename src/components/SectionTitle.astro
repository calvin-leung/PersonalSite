---
interface Props {
  title: string;
  num?: string;
}
const { title, num } = Astro.props;
---

<div class="flex items-baseline gap-3 mb-6">
  {num && <span class="font-mono text-[0.7rem] text-accent tabular-nums">{num}</span>}
  <h2
    class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-ink/70 whitespace-nowrap"
  >
    {title}
  </h2>
  <span class="h-px flex-1 bg-rule"></span>
</div>
