{
  "name": "resume-as-code",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:pdf": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && typst compile typst/resume.typ dist/resume.pdf --font-path typst/fonts --root .",
    "watch:pdf": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && typst watch typst/resume.typ dist/resume.pdf --font-path typst/fonts --root .",
    "validate": "resumed validate resume.json",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{astro,ts,js,mjs,cjs,css,json,md}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "astro": "^4.16.0",
    "resumed": "^6.1.0",
    "tailwindcss": "^3.4.0"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  }
}
